# Tailscale Authentication Key
# Get this from: https://login.tailscale.com/admin/settings/keys
# Create a reusable key with the following settings:
# - Reusable: Yes (for easy reinstalls)
# - Ephemeral: No (device stays in network when container restarts)
# - Pre-approved: Yes (auto-authorize this device)
# - Tags: tag:server (optional, for ACL organization)
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
